    {
      "id": "x9Nb13F6WR3_9W5qOrk0p",
      "type": "text",
      "x": -17.66164080152498,
      "y": -213.6432716348125,
      "width": 435.419677734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
