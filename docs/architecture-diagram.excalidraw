    {
      "id": "Box9n27l83DMuQcenTBeq",
      "type": "text",
      "x": 2123.180714736593,
      "y": 61.004571076827915,
      "width": 553.3396606445312,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP8",
      "roundness": null,
      "seed": 856484902,
      "version": 1079,
      "versionNonce": 167260443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768606626145,
      "link": null,
      "locked": false,
      "text": "- Agent Containers \n    \"container inside a Pod\"\n    - The agent runs inside a container image\n    - The container includes:\n        - Agent code\n        - Dependencies\n        - Runtime (Python, Node, etc.)\n\n- Sandboxes Execution \n    - The agent cannot escape its execution environment\n    - It has limited filesystem access\n    - It cannot access other agents’ memory\n    - It cannot escalate privileges\n\n- Ephermeral Compute \n    - The runtime is created on demand\n    - It runs for one task (or short-lived session)\n    - It is destroyed afterward\n    - No long-lived state is kept inside it\n\n- Scoped Secrets\n    - The agent only receives the secrets it needs\n    - Secrets are injected at runtime\n    - Secrets are not shared across agents\n    - Secrets are not stored in the image",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Agent Containers \n    \"container inside a Pod\"\n    - The agent runs inside a container image\n    - The container includes:\n        - Agent code\n        - Dependencies\n        - Runtime (Python, Node, etc.)\n\n- Sandboxes Execution \n    - The agent cannot escape its execution environment\n    - It has limited filesystem access\n    - It cannot access other agents’ memory\n    - It cannot escalate privileges\n\n- Ephermeral Compute \n    - The runtime is created on demand\n    - It runs for one task (or short-lived session)\n    - It is destroyed afterward\n    - No long-lived state is kept inside it\n\n- Scoped Secrets\n    - The agent only receives the secrets it needs\n    - Secrets are injected at runtime\n    - Secrets are not shared across agents\n    - Secrets are not stored in the image",
      "autoResize": true,
      "lineHeight": 1.25
    },
